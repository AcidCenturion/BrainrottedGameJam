.header {
}

.button {
    width: 500px;
    height: 100px;
    font-size: 105px;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    align-self: center;
    transition-duration: 0.35s;
    -unity-background-image-tint-color: rgb(240, 7, 7);
    -unity-font-definition: url("project://database/Assets/Sprites/BNCOBOY.ttf?fileID=12800000&guid=404dbe8fdb702314eb1420ee806b22ff&type=3#BNCOBOY");
}

.button:hover {
    scale: 1.1 1.1;
    -unity-background-image-tint-color: rgb(251, 15, 15);
}
