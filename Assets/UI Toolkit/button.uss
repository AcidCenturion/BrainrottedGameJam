.button {
    -unity-font-definition: url("project://database/Assets/Sprites/BNCOBOY.ttf?fileID=12800000&guid=404dbe8fdb702314eb1420ee806b22ff&type=3#BNCOBOY");
    font-size: 90px;
    width: 640px;
    align-self: center;
    position: relative;
    background-image: url("project://database/Assets/Sprites/UI/br_button.png?fileID=21300000&guid=0534678fe2123b147918c74fa2d46710&type=3#br_button");
    height: 160px;
    margin-top: -40px;
    margin-bottom: 60px;
    padding-bottom: 32px;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-left-color: rgb(30, 0, 0);
    border-right-color: rgb(30, 0, 0);
    border-top-color: rgb(30, 0, 0);
    border-bottom-color: rgb(30, 0, 0);
    background-color: rgba(255, 255, 255, 0);
}

.button:hover {
    scale: 1.1 1.1;
    -unity-background-image-tint-color: rgb(190, 190, 190);
    transition-duration: 0.35s;
}
