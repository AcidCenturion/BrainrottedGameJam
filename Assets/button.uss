.button {
    width: 640px;
    height: 160px;
    background-image: url("project://database/Assets/Sprites/UI/br_button.png?fileID=21300000&guid=0534678fe2123b147918c74fa2d46710&type=3#br_button");
    font-size: 90px;
    -unity-font-definition: url("project://database/Assets/Sprites/BNCOBOY.ttf?fileID=12800000&guid=404dbe8fdb702314eb1420ee806b22ff&type=3#BNCOBOY");
    -unity-background-image-tint-color: rgb(255, 255, 255);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    align-self: center;
    transition-duration: 0.35s;
    color: rgb(27, 27, 27);
}

.button:hover {
    transition-property: all;
    transition-duration: 0s;
    transition-timing-function: ease;
    transition-delay: 0s;
    scale: 1.1 1.1;
    background-color: rgb(0, 0, 0);
    -unity-background-image-tint-color: rgb(186, 186, 186);
}
